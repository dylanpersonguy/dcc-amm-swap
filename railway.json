{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build --workspace=amm-core --workspace=amm-sdk --workspace=amm-bot"
  },
  "deploy": {
    "startCommand": "node amm-bot/dist/index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
